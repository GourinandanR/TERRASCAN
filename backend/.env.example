TERRASCAN_DB_PATH=/app/data/terrascan.sqlite3
TERRASCAN_CORS_ORIGINS=http://localhost:5173
TERRASCAN_AUTH_REQUIRED=true
# Generate unique random keys of at least 32 characters; never commit actual keys.
TERRASCAN_API_KEYS=REPLACE_WITH_RANDOM_64_CHAR_READ_KEY:read,REPLACE_WITH_RANDOM_64_CHAR_ADMIN_KEY:admin
