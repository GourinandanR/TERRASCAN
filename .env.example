# Copy to .env. Replace every example value before deployment.
TERRASCAN_DB_PATH=/app/data/terrascan.sqlite3
TERRASCAN_CORS_ORIGINS=http://localhost:5173
TERRASCAN_AUTH_REQUIRED=true
# Generate unique random keys of at least 32 characters. Format: key:role,key:role
# Roles: read (GET only), admin (GET and write methods).
VITE_API_BASE_URL=http://localhost:8000
VITE_USER_AUTH_REQUIRED=true
