{
  "name": "terrascan",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "inspect:dataset": "node scripts/inspect-dataset.mjs",
    "ingest:download": "python scripts/terrascan_ingest.py download",
    "ingest:inspect": "python scripts/terrascan_ingest.py inspect",
    "ingest:manifest": "python scripts/terrascan_ingest.py manifest",
    "process:grid": "python scripts/terrascan_process.py grid",
    "process:terrain": "python scripts/terrascan_process.py terrain",
    "process:zonal": "python scripts/terrascan_process.py zonal",
    "api:dev": "cd backend && python run.py",
    "pipeline:run": "python scripts/terrascan_pipeline.py",
    "pipeline:test": "python -m unittest scripts/test_terrascan_pipeline.py -v",
    "features:extract": "python scripts/terrascan_features.py extract",
    "features:test": "python -m unittest scripts.test_terrascan_features -v",
    "review:test": "cd backend && python -m pytest -q tests/test_api.py",
    "reports:test": "cd backend && python -m pytest -q tests/test_api.py",
    "pds:search": "python scripts/terrascan_pds.py search",
    "pds:resolve": "python scripts/terrascan_pds.py resolve",
    "data:validate": "python scripts/terrascan_validate.py",
    "spatial:analyze": "python scripts/terrascan_spatial.py",
    "spatial:test": "python -m unittest scripts.test_terrascan_spatial -v",
    "surface:classify": "python scripts/terrascan_classify.py",
    "surface:test": "python -m unittest scripts.test_terrascan_classify -v",
    "analogs:discover": "python scripts/terrascan_analog_discovery.py",
    "analogs:test": "python -m unittest scripts.test_terrascan_analog_discovery -v",
    "ml:train": "python scripts/terrascan_ml.py train",
    "ml:predict": "python scripts/terrascan_ml.py predict",
    "ml:test": "python -m unittest scripts.test_terrascan_ml -v",
    "predict:train": "python scripts/terrascan_predict.py train",
    "predict:run": "python scripts/terrascan_predict.py predict",
    "predict:test": "python -m unittest scripts.test_terrascan_predict -v",
    "sites:rank": "python scripts/terrascan_rank_sites.py",
    "sites:test": "python -m unittest scripts.test_terrascan_rank_sites -v",
    "qa:project": "python scripts/terrascan_qa.py project",
    "qa:integrity": "python scripts/terrascan_qa.py integrity",
    "qa:test": "python -m unittest scripts.test_terrascan_qa -v",
    "release:qa": "npm run qa:project && npm run qa:test",
    "release:audit": "python scripts/terrascan_release.py",
    "release:verify": "python scripts/terrascan_release.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "maplibre-gl": "^6.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.7"
  }
}
